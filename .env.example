# adsCombine environment configuration example
# Copy to .env for local work. Never commit .env or real credentials.

# ── Core Service & Authentication ──
BASE_URL=http://localhost:3000
PORT=3000
TOKEN=<bearer-token>
JOBS_TOKEN=<jobs-bearer-token>
REQUEST_LOGS_ENABLED=false

# ── OpenAI Configuration ──
OPENAI_API_KEY=<openai-api-key>
OPENAI_MODEL_TEXT=gpt-4o-mini

# ── Safe File Download & Storage Origins ──
# Explicit allowed URL prefixes for downloading source files (exact-origin recommended).
FILE_DOWNLOAD_ALLOWED_URL_PREFIXES=<allowed-download-url-prefixes>
SUPABASE_URL=<supabase-project-url>
SUPABASE_STORAGE_URL=<supabase-storage-url>
STORAGE_URL=<storage-url>

# ── Job Queue & Concurrency Limits ──
PROCESSING_CONCURRENCY=5
JOBS_MAX_CONCURRENCY=1
JOBS_MAX_QUEUE_SIZE=100
JOBS_RETENTION_HOURS=24
JOB_STALE_AFTER_MS=3600000

# ── OCR & Document Processing Limits ──
EXTRACTION_MAX_FILE_BYTES=104857600
MAX_FILES_PER_JOB=10
MAX_PDF_PAGES=300
MAX_OCR_PAGES_PER_PDF=150
MAX_TOTAL_OCR_PAGES_PER_JOB=200
OCR_MAX_PAGES_PER_CHUNK=2
PDF_OCR_ALWAYS_THRESHOLD=5
PDF_BYTES_PER_PAGE_THRESHOLD=50000
MIXED_PAGE_OCR_DIRECT_MAX_PAGES=10
MIXED_PAGE_MIN_NATIVE_CHARS_PER_PAGE=80

# ── Selective Visual Fallback (Gemini default; DeepSeek optional) ──
GEMINI_API_KEY=<gemini-api-key>
DEEPSEEK_API_KEY=<deepseek-api-key>
VISUAL_FALLBACK_ENABLED=false
VISUAL_FALLBACK_SHADOW_MODE=true
# Select gemini (default) or deepseek. Set only the matching provider key.
VISUAL_FALLBACK_PROVIDER=gemini
# safe-visual-v1 is the backward-compatible default. The opt-in
# gemini-whole-page-critical-v2 policy is enabled only with the Gemini provider.
VISUAL_RECONCILIATION_POLICY_VERSION=safe-visual-v1
# Optional override. Defaults to gemini-2.5-flash for Gemini, or
# deepseek-v4-flash-vision-exp when VISUAL_FALLBACK_PROVIDER=deepseek.
# VISUAL_FALLBACK_MODEL=
VISUAL_FALLBACK_TIMEOUT_MS=15000
VISUAL_FALLBACK_MAX_RETRIES=1
# No second adjudication/model strategy; configured retries may repeat the same provider request.
VISUAL_FALLBACK_CONCURRENCY=1
VISUAL_FALLBACK_MAX_PAGES_PER_PDF=2
MAX_TOTAL_VISUAL_FALLBACK_PAGES_PER_JOB=4
